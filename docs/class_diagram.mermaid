classDiagram
    direction TB

    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    %% TEXT MODEL (text.py) — the single input
    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    class SourceText {
        +str title
        +str content
        +str translation
        +str source_lang
        +str target_lang
        +str cefr_level
        +str topic
        +PictureScene picture_scene
        +VocabularyNode vocabulary
        +GrammarNode grammar
        +list~Compound~ compounds
        +paragraphs() list~str~
        +from_dict(dict) SourceText
        +to_dict() dict
    }

    class PictureScene {
        +str description
        +str caption
        +int paragraph_index
        +list~SceneElement~ elements
        +colored() list~SceneElement~
        +positioned() list~SceneElement~
        +key_elements() list~SceneElement~
    }

    class SceneElement {
        +str name
        +str color
        +str position
        +bool key
    }

    class VocabularyItem {
        +str term
        +str translation
        +str pos
        +SemanticType semantic_type
        +str synonym
        +str antonym
    }

    class GrammarPhenomenon {
        +str name
        +str description
        +list~str~ examples
    }

    class Compound {
        +str left
        +str right
        +str compound
        +str translation
    }

    SourceText *-- PictureScene
    SourceText *-- VocabularyItem : vocabulary.items
    SourceText *-- GrammarPhenomenon : grammar.phenomena
    SourceText *-- Compound
    PictureScene *-- SceneElement

    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    %% KNOWLEDGE GRAPH (graph.py) — what exercises exist
    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    class ExerciseGraph {
        +dict nodes
        +list~Edge~ edges
        +exercises() list~ExerciseNode~
        +get_by_type(type) list~ExerciseNode~
        +get_combinable(id) list~ExerciseNode~
    }

    class ExerciseNode {
        +str id
        +ExerciseType exercise_type
        +int difficulty
        +tuple cefr_range
        +list~LearningFocus~ learning_focus
        +int estimated_minutes
        +str display_name
        +str short_instruction
        +list~str~ combinable_with
        +title() str
    }

    class Edge {
        +str source
        +str target
        +EdgeType edge_type
    }

    ExerciseGraph *-- ExerciseNode
    ExerciseGraph *-- Edge

    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    %% PIPELINE (plan.py / generate.py / render.py)
    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    class MaterialLedger {
        +set used_sentences
        +set used_terms
        +reserve(sentence, term) void
        +sentence_free(sentence) bool
        +term_free(term) bool
    }

    class ExerciseInstance {
        +str node_id
        +str title
        +str instruction
        +list~dict~ items
        +list~dict~ solution
        +list~str~ word_bank
        +str picture_prompt
        +int estimated_minutes
        +int difficulty
    }

    class plan {
        <<module>>
        +build_worksheet(text, ids, graph, seed)
        +order_node_ids(graph, ids)
    }

    class generate {
        <<module>>
        +generate_exercise(node, text, rng, ledger)
    }

    class render {
        <<module>>
        +render_worksheet(text, exercises, path)
    }

    plan ..> generate : per node
    generate ..> MaterialLedger : reserve / check
    generate ..> ExerciseNode : reads metadata
    generate ..> SourceText : reads facts
    generate --> ExerciseInstance : produces
    plan --> ExerciseInstance
    render ..> ExerciseInstance : lays out
    render ..> SourceText : story / refs
