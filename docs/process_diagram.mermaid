flowchart TB
    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    %% WORKSHEET GENERATION FLOW (text → PDF, deterministic)
    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    START([User / Claude writes source-text JSON]) --> LOAD

    subgraph INPUT["Input"]
        direction TB
        LOAD[SourceText.from_dict]
        LOAD --> FACTS{{"story · vocabulary · grammar<br/>structured picture scene · compounds"}}
    end

    FACTS --> SELECT

    subgraph SELECT_STAGE["Exercise selection (cli.py)"]
        direction TB
        SELECT["--exercises given?"]
        SELECT -- "yes" --> EXPLICIT[use the listed node ids]
        SELECT -- "no" --> AUTO["select_exercises():<br/>filter by CEFR band +<br/>available material,<br/>prefer --focus, gentle ramp,<br/>add one combinable partner"]
    end

    EXPLICIT --> ORDER
    AUTO --> ORDER

    subgraph PLAN["Planning (plan.py)"]
        direction TB
        ORDER["order_node_ids():<br/>WordConn → FIB → Picture,<br/>then by difficulty"]
        ORDER --> LEDGER[(MaterialLedger<br/>used sentences + words)]
    end

    LEDGER --> GEN

    subgraph GENERATE["Generation per node (generate.py)"]
        direction TB
        GEN{exercise type?}
        GEN -- FIB --> FIB["blank vocab words in story order<br/>(skip spent sentences/words,<br/>attach hint)"]
        GEN -- Picture --> PIC["read scene facts:<br/>colour / position / name<br/>(nothing hard-coded)"]
        GEN -- WordConn --> WC["pair by translation / synonym /<br/>antonym / category / compound"]
        FIB --> RESERVE
        PIC --> RESERVE
        WC --> RESERVE
        RESERVE[/reserve used material<br/>on the ledger/]
    end

    RESERVE --> INST[[list of ExerciseInstance<br/>items + solutions]]

    INST --> RENDER

    subgraph OUTPUT["Rendering (render.py)"]
        direction TB
        RENDER["render_worksheet()"]
        RENDER --> P1[Story page]
        RENDER --> P2[Numbered exercises<br/>KeepTogether]
        RENDER --> P3[Grammar + vocabulary]
        RENDER --> P4[Answer key]
    end

    P1 --> PDF([worksheet.pdf])
    P2 --> PDF
    P3 --> PDF
    P4 --> PDF

    classDef invariant fill:#eef4ff,stroke:#2f5bd0,color:#16223b;
    class LEDGER,RESERVE invariant;
